## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache files
.vs/

# Rider
.idea/

# User-specific files
*.user
*.suo

# NuGet
*.nupkg
packages/

# Test results
[Tt]est[Rr]esult*/
